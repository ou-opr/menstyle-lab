#!/bin/sh
# git pre-push 门禁：推送前跑离线回归网（npm test），失败则阻止推送。
# 安装见 scripts/install-hooks.mjs（把 core.hooksPath 指到本目录）。
# 本文件必须是 LF 换行，否则 Git for Windows 的 sh 可能无法执行。

set -e

# 逃生门：SKIP_TESTS=1 时直接放行（紧急 hotfix 用）。
if [ "${SKIP_TESTS:-0}" = "1" ]; then
  echo "[pre-push] SKIP_TESTS=1 —— 已跳过回归测试。" >&2
  exit 0
fi

# 只在 style-lab 项目内生效。在别的仓库/别处被调用时安静退出，而不是报错。
root=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$root" ] || [ ! -f "$root/package.json" ]; then
  echo "[pre-push] 未识别到项目根，跳过检查。" >&2
  exit 0
fi

if [ ! -f "$root/scripts/test-engine.mjs" ]; then
  echo "[pre-push] $root 不是 style-lab 项目（缺少 scripts/test-engine.mjs），跳过检查。" >&2
  exit 0
fi

cd "$root" || exit 0

# Git for Windows 下 npm 可能是 POSIX shim 或 npm.cmd，两者都试。
if command -v npm >/dev/null 2>&1; then
  NPM=npm
elif command -v npm.cmd >/dev/null 2>&1; then
  NPM=npm.cmd
else
  echo "[pre-push] 找不到 npm，跳过检查（不阻塞推送）。" >&2
  exit 0
fi

echo "[pre-push] 运行 npm test（离线回归网，16 步）..." >&2

if "$NPM" test; then
  echo "[pre-push] 回归网通过，允许推送。" >&2
  exit 0
fi

echo "" >&2
echo "==============================================================" >&2
echo "[pre-push] ✖ 回归测试失败，推送已被阻止（未产生任何远端变更）。" >&2
echo "[pre-push]   先本地修复：npm test" >&2
echo "[pre-push]   确需临时跳过：SKIP_TESTS=1 git push" >&2
echo "[pre-push]     PowerShell: \$env:SKIP_TESTS=1; git push" >&2
echo "==============================================================" >&2
exit 1
